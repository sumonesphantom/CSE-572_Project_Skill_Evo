{
  "arm": "noskill",
  "seed": 0,
  "rounds": 8,
  "batch_size": 40,
  "workers": 2,
  "eval_every": 1,
  "runs_dir": "runs",
  "data": {
    "task_files": [
      "data/processed/bird.jsonl",
      "data/processed/spider.jsonl"
    ],
    "splits_file": "data/processed/splits.json",
    "train": "bird:train",
    "val": "bird:val",
    "test": {
      "bird_test": "bird:test",
      "spider_transfer": {
        "split": "spider:test",
        "max": 200
      }
    }
  },
  "llm": {
    "host": "http://localhost:11434",
    "solver": "llama3.2:1b",
    "evolver": "glm-4.7-flash:latest",
    "cache": "data/cache/llm_cache.sqlite",
    "solver_ctx": 8192,
    "evolver_ctx": 16384
  },
  "solver": {
    "top_k": 3,
    "min_score": 0.5,
    "repair": true,
    "sql_timeout": 30
  },
  "evolver": {
    "max_ops": 4,
    "n_fail": 10,
    "n_success": 3,
    "show_gold": true
  },
  "monitor": {
    "probe_relevant": 30,
    "probe_random": 20,
    "min_net": 2,
    "alpha": 0.05,
    "min_uses": 5,
    "loo": true,
    "loo_max_tasks": 8,
    "rollback_min_net": 3,
    "audit_split": "bird_test"
  },
  "root": "."
}